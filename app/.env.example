# Son of the One Group — build-time configuration (Vite)
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ---- Supabase (required) ----------------------------------------------------
VITE_SUPABASE_URL=https://gkjbrfwidybzptvgifxz.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Stripe (optional; checkout is disabled when unset) ---------------------
# Publishable keys are safe to ship in a browser bundle. The SECRET key belongs
# only in the edge-function secrets, never here.
# Use pk_test_... on staging.
VITE_STRIPE_PUBLISHABLE_KEY=

# Only for Stripe Connect setups. The recovered Famous.ai build used
# acct_1SjRPrHzXgTRD3HA — confirm Robert controls that account before reusing it.
VITE_STRIPE_ACCOUNT_ID=
